{
  "name": "assistant-agent",
  "displayName": "Assistant Agent",
  "description": "Local AI coding assistant MVP for VS Code",
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.90.0"
  },
  "main": "./src/extension.js",
  "activationEvents": [
    "onStartupFinished"
